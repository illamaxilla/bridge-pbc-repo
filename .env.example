# ─── Client (browser) — Supabase public credentials ────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Server-side only — NEVER prefix with VITE_ ────────────────────────────────

# Anthropic API key for BRIDGE AI Chat
ANTHROPIC_API_KEY=sk-ant-api03-...

# Supabase service role key (bypasses RLS for server-side inserts from the
# /api/request-access handler). Get it from: Supabase Dashboard → Settings → API.
# If unset, the handler falls back to the anon key — which still works because
# the `public` role has an INSERT policy on `access_requests`, but the service
# role is recommended for production.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Optional: explicit SUPABASE_URL for the server handler. If unset, it falls
# back to VITE_SUPABASE_URL.
# SUPABASE_URL=https://your-project.supabase.co

# ─── Email relay (Resend) for the Request Access form ─────────────────────────
# Get an API key at https://resend.com. Verify your sender domain first.
# If RESEND_API_KEY or ACCESS_REQUEST_FROM_EMAIL is unset, the form will still
# save requests to the database but no emails will be sent (logged warning).
RESEND_API_KEY=re_...
ACCESS_REQUEST_FROM_EMAIL=BRIDGE PBC <hello@bridgepbc.com>
ACCESS_REQUEST_NOTIFY_EMAIL=team@bridgepbc.com
